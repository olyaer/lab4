import sys

lines =[line.strip() for line in sys.stdin if line.strip()]
iterator = iter(lines)

for a in iterator: 
    b = next(iterator, None) 
    if b is None:
        break
    count = 0
    start = 0
    while True:
        pos = a.find(b, start)
        if pos == -1:
            break
        count += 1
        start = pos + 1

    print(count)
